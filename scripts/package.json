  "description": "robotics.makerlabkids.com: the Maker Lab Kids robot workshop (mecanum and 2WD robots): apps, lessons, firmware, tests",
  "private": true,
  "scripts": {
    "serve": "cd .. && python3 -m http.server 8191 --bind 0.0.0.0",
